# Chave da API xAI (usada apenas no servidor, por /api/professor).
# Copie para .env e preencha. Nunca comite a chave real.
XAI_API_KEY=coloque_sua_chave_aqui

# Assinatura de release Android (veja INSTALAR.md).
# Estes valores são lidos pelo Gradle em android/app/build.gradle.
# Nunca comite a keystore nem as senhas reais. Alternativa: android/keystore.properties (ignorado).
RETA_KEYSTORE_PATH=/caminho/fora/do/repo/reta-release.jks
RETA_KEYSTORE_PASSWORD=coloque_a_senha_da_keystore
RETA_KEY_ALIAS=reta
RETA_KEY_PASSWORD=coloque_a_senha_da_chave
