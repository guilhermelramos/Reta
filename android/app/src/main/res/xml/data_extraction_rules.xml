<?xml version="1.0" encoding="utf-8"?>
<!--
  Regras do Android 12+ (backup na nuvem e transferência entre aparelhos).
  android:allowBackup continua "false"; estas exclusões impedem que uma chave
  xAI/OpenRouter ou os tokens do login experimental saiam do cofre seguro.

  WSSecureStorageSharedPreferences é o arquivo do
  @aparajita/capacitor-secure-storage (Keystore). O IndexedDB do WebView fica
  em app_webview/, excluído pelo domínio root/file.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    <exclude domain="root" path="app_webview/" />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    <exclude domain="root" path="app_webview/" />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
  </device-transfer>
</data-extraction-rules>
